{
  "version": 1,
  "controllerId": "background-workload",
  "profileId": "gpu.background-training",
  "unit": "installed-training.service",
  "normalMode": "normal",
  "releasedMode": "checkpoint-release",
  "checkpointRoot": "/absolute/path/to/immutable-checkpoints",
  "checkpointReceiptFile": "/absolute/path/to/immutable-checkpoints/latest-receipt.json",
