# Copy to ~/.config/go7-spark-broker/env and replace every /absolute/path value.
SPARK_BROKER_ID=local-capability-host
SPARK_BROKER_BIND=127.0.0.1
SPARK_BROKER_PORT=8790
# deploy-user.sh supplies these safe per-user defaults when omitted.
# SPARK_BROKER_TOKEN_FILE=/absolute/path/to/broker-token
# SPARK_BROKER_DATA=/absolute/path/to/broker-data
# SPARK_MAX_PENDING_JOBS=1000
# SPARK_MAX_ARTIFACT_BYTES=2147483648
# SPARK_MAX_STORAGE_BYTES=107374182400
# SPARK_REQUEST_TIMEOUT_SECONDS=30
# SPARK_MAX_CONCURRENT_UPLOADS=2

# Optional OpenAI-compatible text runtime. Legacy SPARK_TEXT_* names remain accepted.
# SPARK_OPENAI_ENDPOINT=http://127.0.0.1:8000
# SPARK_OPENAI_API_KEY_FILE=/absolute/path/to/runtime-client-key
# SPARK_OPENAI_MODEL=your-model-id
# SPARK_OPENAI_CONTAINER=your-container-name
# SPARK_OPENAI_PROFILE_ID=gpu.local-text
# SPARK_OPENAI_DESCRIPTION=Local OpenAI-compatible text generation
# SPARK_OPENAI_ESTIMATED_MEMORY_GB=48

# Optional multi-profile inference routing. This replaces the single-runtime
# variables above when present. Copy the example outside the repository and
# use absolute credential-file paths.
# SPARK_OPENAI_ROUTES_FILE=/absolute/path/to/inference-routes.json

# Optional fenced resource admission and throttle/governor integration.
# Shared execution is disabled unless the policy contains an exact tested
# profile-pair certification.
# SPARK_RESOURCE_POLICY_FILE=/absolute/path/to/resource-policy.json

# Optional built-in Hunyuan3D adapter.
# Keep the workload under ~/.local/share/go7-spark-broker/ or ~/workloads when using the
# shipped user service, or add an explicit systemd ReadWritePaths drop-in for another location.
# SPARK_HUNYUAN_ROOT=/absolute/path/to/hunyuan3d-workload
